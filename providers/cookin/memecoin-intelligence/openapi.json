{
    "components": {
        "securitySchemes": {
            "proApiKey": {
                "description": "Cookin Pro API key. Optional when paying per call with x402.",
                "scheme": "bearer",
                "type": "http"
            }
        }
    },
    "info": {
        "description": "Real-time Solana memecoin intelligence from Cookin: token quality scores, bundle (coordinated wallet) detection, holder behavior, KOL positions, trader profiles, and deployer history.\n\nPay per call with x402 (USDC on Solana, no account or API key), or send a Pro API key as a Bearer token (1 SOL per 30 days, at https://cookin.fun/account/api-keys). A request with neither gets 402 with both options: the x402 offer in the PAYMENT-REQUIRED header and the Pro link in the body.",
        "title": "Cookin API",
        "version": "1.0.0"
    },
    "openapi": "3.1.0",
    "paths": {
        "/v1/devs/{address}/tokens": {
            "get": {
                "description": "Launch history of one token deployer: every token, bond rate, and peak market caps.",
                "operationId": "getDevsAddressTokens",
                "parameters": [
                    {
                        "description": "Deployer wallet address (base58).",
                        "example": "7xKXtg2CW87d97TXJSDpbD5jBkheTqA83TZRuJosgAsU",
                        "in": "path",
                        "name": "address",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Tokens per page, 1 to 100 (default 50).",
                        "example": "50",
                        "in": "query",
                        "name": "limit",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "description": "Tokens to skip, for paging (default 0).",
                        "example": "0",
                        "in": "query",
                        "name": "offset",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object"
                                }
                            }
                        },
                        "description": "The requested data, in the `data` field of the envelope."
                    },
                    "402": {
                        "description": "Payment required. Pay for this call with x402 (offer in the PAYMENT-REQUIRED header, USDC on Solana), or send a Pro API key."
                    },
                    "404": {
                        "description": "No data for this address. A paid call is not charged."
                    },
                    "429": {
                        "description": "Rate limit exceeded. See the Retry-After header."
                    }
                },
                "security": [
                    {},
                    {
                        "proApiKey": []
                    }
                ],
                "summary": "List the launch history of one token deployer",
                "x-payment-info": {
                    "price": "$0.01",
                    "pricingMode": "fixed",
                    "protocols": [
                        "x402"
                    ]
                }
            }
        },
